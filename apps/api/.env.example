# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Comma-separated origins allowed by CORS (web + admin dev servers)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://chikbo:chikbo_dev_password@localhost:5432/chikbo?schema=public

# --- Auth -------------------------------------------------------------------
JWT_ACCESS_SECRET=replace-with-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# --- Razorpay (server-side only — NEVER ship these to web/mobile) -----------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# --- Shiprocket (server-side only) ------------------------------------------
SHIPROCKET_EMAIL=api-user@chikbo.in
SHIPROCKET_PASSWORD=xxxxxxxx
SHIPROCKET_PICKUP_LOCATION=Primary
# Optional shared token to authenticate Shiprocket webhook calls
SHIPROCKET_WEBHOOK_TOKEN=replace-with-random-token

# --- Email (SMTP; e.g. Amazon SES / Zoho / Gmail app password) --------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Chikbo <no-reply@chikbo.in>"

# --- WhatsApp (optional; provider HTTP API e.g. Gupshup/Interakt/Twilio) ----
WHATSAPP_API_URL=
WHATSAPP_API_KEY=

# --- Push (Firebase Cloud Messaging HTTP v1 service-account JSON path) ------
FCM_SERVICE_ACCOUNT_JSON=/absolute/path/to/secrets/firebase-service-account.json

# --- Seed -------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@chikbo.in
SEED_ADMIN_PASSWORD=ChangeMe@123

# --- Google Sign-In (preferred: Firebase Authentication) --------------------
# Web API Key from the Firebase console -> Project settings -> General.
# Public by design; server-side verification uses FCM_SERVICE_ACCOUNT_JSON
# above. Also enable the Google provider under Authentication -> Sign-in
# method in the same Firebase project. See docs/google-auth-setup.md.
FIREBASE_WEB_API_KEY=

# Legacy direct-GIS alternative: OAuth 2.0 "Web application" client ID from
# https://console.cloud.google.com (APIs & Services -> Credentials). Not
# needed when Firebase sign-in is configured. Safe to expose to the browser;
# the secret is NOT needed because we verify ID tokens, not the auth-code flow.
GOOGLE_CLIENT_ID=

# --- Password reset ---------------------------------------------------------
# Public storefront URL used to build reset links in emails.
WEB_APP_URL=http://localhost:5173

# --- SEO --------------------------------------------------------------------
# Canonical origin for every SEO URL: canonicals, sitemap entries, JSON-LD and
# OG tags. MUST be the production https domain before launch — leaving this on
# localhost publishes localhost canonicals and de-indexes the site.
# (Reuses WEB_APP_URL above; set that and SEO follows.)
