# Chikbo storefront (apps/web) — copy to .env.local and adjust.

# Base URL of the API, including the version prefix.
# Leave unset in development: the Vite dev server proxies /api to localhost:4000.
# VITE_API_URL=https://api.chikbo.in/api/v1

# Canonical public origin of the storefront, no trailing slash.
# Every <link rel="canonical">, og:url, JSON-LD url and the sitemap are built
# from this. Set it in every deployed environment — without it the app falls
# back to window.location.origin, which would make a preview deployment
# self-canonicalise and compete with production in search results.
VITE_SITE_URL=https://chikbo.in
