{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && npm install",
  "build": {
    "env": {
      "VITE_API_URL": "https://chikbo.onrender.com/api/v1"
    }
  },
  "buildCommand": "cd ../.. && npm run build --workspace packages/shared && npm run build --workspace apps/web",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/((?!assets/).*)", "destination": "/index.html" }]
}
