# Copy to /var/www/chikbo/apps/api/.env on the server and fill in the blanks.
# Never commit the real file.

NODE_ENV=production
PORT=4000

# Public address of the store — used in emails, sitemap, canonical links.
WEB_APP_URL=https://chikbo.com
CORS_ORIGINS=https://chikbo.com,https://www.chikbo.com

# Serve the storefront and admin from this same process.
WEB_DIST_DIR=/var/www/chikbo/apps/web/dist
ADMIN_DIST_DIR=/var/www/chikbo/apps/admin/dist/admin

# Neon Postgres
DATABASE_URL=
DIRECT_URL=

# Long random strings (e.g. `openssl rand -hex 48`). Changing them signs everyone out.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Razorpay — switch to live keys (rzp_live_…) when you start taking real payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you type when creating the webhook https://chikbo.com/api/v1/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=

# Shiprocket API user. Quote the password if it contains # or $.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=''
# Must match the pickup address nickname in Shiprocket > Settings > Pickup Addresses.
SHIPROCKET_PICKUP_LOCATION=work
# Token you type when creating the webhook https://chikbo.com/api/v1/webhooks/courier
# (Shiprocket rejects URLs containing the word "shiprocket")
SHIPROCKET_WEBHOOK_TOKEN=

# Cloudflare R2 — uploaded photos and videos.
R2_ENDPOINT=https://0d42547d7b199087e42664d7750c2757.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=chikbo
R2_PUBLIC_URL=

# Email (order confirmations, password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Chikbo <no-reply@chikbo.com>

# Google sign-in (optional)
GOOGLE_CLIENT_ID=
FIREBASE_WEB_API_KEY=
FCM_SERVICE_ACCOUNT_JSON=
